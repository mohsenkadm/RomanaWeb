@{
    ViewData["Title"] = "المندوبين";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content">
    <div class="content dark-edition">
        <div class="container-fluid">

            <div class="rm-page-summary">
                <div class="rm-summary-icon bg-orange"><i class="material-icons">badge</i></div>
                <div class="rm-summary-body">
                    <h4>ادارة المندوبين</h4>
                    <p>عرض وادارة السائقين/المندوبين. حدّد لكل مندوب المطاعم والزونات بشكل منفصل.</p>
                </div>
            </div>

            <div class="rm-filter-bar">
                <div class="row align-items-end">
                    <div class="col-lg-2 col-md-3 col-sm-6 mb-2">
                        <button type="button" class="btn btn-success btnwidth" style="width:100%;" onclick="openAddSaleMan()" data-toggle="modal" data-target="#SaleManModal">اضافة جديد <i class="material-icons">add</i></button>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-12 mb-2">
                        <label class="mb-1">بحث عن الاسم</label>
                        <input type="text" class="form-control alignright" placeholder="اكتب الاسم" autocomplete="off" name="Namese" id="Namese">
                    </div>
                    <div class="col-lg-2 col-md-3 col-sm-6 mb-2">
                        <button type="button" id="search-btn" class="btn btn-info btnwidth" style="width:100%;">بحث <i class="material-icons">search</i></button>
                    </div>
                </div>
            </div>

            <div id="saleManCards" class="saleman-cards"></div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="SaleManModal" tabindex="-1" role="dialog" aria-labelledby="SaleManModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable saleman-modal" role="document">
        <div class="modal-content dark-edition">
            <div class="modal-header">
                <h5 class="modal-title" id="SaleManModalLabel">اضافة جديد</h5>
                <button type="button" id="close1" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body saleman-modal-body">
                <div class="row">
                    <div class="col-md-6 mb-3 alignright">
                        <label class="text-primary">اسم المندوب</label>
                        <input type="text" placeholder="اكتب الاسم" class="form-control alignright" autocomplete="off" name="Name" id="Name" />
                    </div>
                    <div class="col-md-6 mb-3 alignright">
                        <label class="text-primary">رقم الهاتف</label>
                        <input type="text" placeholder="اكتب رقم الهاتف" class="form-control alignright" autocomplete="off" name="Phone" id="Phone" />
                    </div>
                    <div class="col-md-6 mb-3 alignright">
                        <label class="text-primary">العنوان</label>
                        <input type="text" placeholder="اكتب العنوان" class="form-control alignright" autocomplete="off" name="Address" id="Address" />
                    </div>
                    <div class="col-md-6 mb-3 alignright">
                        <label class="text-primary">كلمة المرور</label>
                        <input type="text" placeholder="اكتب كلمة المرور" class="form-control alignright" autocomplete="off" name="Password" id="Password" />
                    </div>
                    <div class="col-md-6 mb-3 alignright">
                        <label class="text-primary">نشاط المندوب</label>
                        <div class="form-check">
                            <label class="form-check-label">
                                <input class="form-check-input" type="checkbox" id="IsActive">
                                <span class="form-check-sign"><span class="check"></span></span>
                            </label>
                        </div>
                        <small class="d-block text-muted">عند الإلغاء يبقى الحساب لكن لا يمكنه استخدام التطبيق ولا تُجلب له طلبات</small>
                    </div>
                    <div class="col-md-6 mb-3 alignright">
                        <label class="text-primary">استلام أكثر من طلب في نفس الوقت</label>
                        <div class="form-check">
                            <label class="form-check-label">
                                <input class="form-check-input" type="checkbox" id="AllowMultiOrders">
                                <span class="form-check-sign"><span class="check"></span></span>
                            </label>
                        </div>
                        <small class="d-block text-muted">عند التفعيل يستطيع استلام أكثر من طلب ضمن العدد المسموح</small>
                    </div>
                    <div class="col-md-6 mb-3 alignright" id="MaxConcurrentOrdersWrap">
                        <label class="text-primary">عدد الطلبات المسموح باستلامها معاً</label>
                        <input type="number" min="2" max="20" value="2" class="form-control alignright" autocomplete="off" name="MaxConcurrentOrders" id="MaxConcurrentOrders" />
                        <small class="d-block text-muted">يُطبَّق فقط عند تفعيل الاستلام المتعدد (حد أدنى 2)</small>
                    </div>
                </div>

                <div class="saleman-assign-stack">
                    <div class="saleman-assign-card saleman-assign-restaurants mb-3">
                        <div class="saleman-assign-head">
                            <span class="saleman-assign-icon"><i class="material-icons">storefront</i></span>
                            <div class="flex-grow-1">
                                <h6 class="saleman-assign-title mb-0">1) المطاعم التي يعمل لديها</h6>
                                <small class="text-muted">اختر مطعماً أو أكثر — يستلم إشعارات طلبات هذه المطاعم فقط</small>
                            </div>
                        </div>
                        <div id="saleManRestaurantPicker" class="saleman-picker-list"></div>
                    </div>
                    <div class="saleman-assign-card saleman-assign-zones mb-1">
                        <div class="saleman-assign-head">
                            <span class="saleman-assign-icon"><i class="material-icons">map</i></span>
                            <div class="flex-grow-1">
                                <h6 class="saleman-assign-title mb-0">2) زونات العمل</h6>
                                <small class="text-muted">اختر زوناً أو أكثر — يستلم طلبات الزبائن داخل هذه الزونات فقط</small>
                            </div>
                        </div>
                        <div id="saleManZonePicker" class="saleman-picker-list"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="close" data-dismiss="modal">اغلاق</button>
                <button type="button" class="btn btn-success" id="save">حفظ</button>
            </div>
        </div>
    </div>
</div>

<div id="mydiv">
    <script>
        $("#close").on("click", (e) => {
            e.preventDefault();
            aftersaveSaleMan();
        });
        $("#close1").on("click", (e) => {
            e.preventDefault();
            aftersaveSaleMan();
        });
        $("#search-btn").on("click", (e) => {
            e.preventDefault();
            RefreshSaleMan();
        });
        $(document).ready(function () {
            function syncMultiOrderUi() {
                var on = $('#AllowMultiOrders').is(':checked');
                $('#MaxConcurrentOrdersWrap').toggle(on);
                if (on && (parseInt($('#MaxConcurrentOrders').val(), 10) || 0) < 2)
                    $('#MaxConcurrentOrders').val(2);
            }
            $('#AllowMultiOrders').on('change', syncMultiOrderUi);
            syncMultiOrderUi();

            if (typeof ZonePicker !== 'undefined') {
                ZonePicker.loadSummary(function () {
                    if (typeof RestaurantPicker !== 'undefined') {
                        RestaurantPicker.loadSummary(function () {
                            call_ajax("GET", "SaleMan/GetAll", null, filltableSaleMan);
                        });
                    } else {
                        call_ajax("GET", "SaleMan/GetAll", null, filltableSaleMan);
                    }
                });
            } else if (typeof RestaurantPicker !== 'undefined') {
                RestaurantPicker.loadSummary(function () {
                    call_ajax("GET", "SaleMan/GetAll", null, filltableSaleMan);
                });
            } else {
                call_ajax("GET", "SaleMan/GetAll", null, filltableSaleMan);
            }
        });
        $("#save").on("click", (e) => {
            e.preventDefault();
            var IsActive = $('#IsActive').is(":checked");
            var allowMulti = $('#AllowMultiOrders').is(":checked");
            var maxConcurrent = parseInt($("#MaxConcurrentOrders").val(), 10) || 1;
            if (allowMulti && maxConcurrent < 2) maxConcurrent = 2;
            if (!allowMulti) maxConcurrent = 1;
            var object = {
                SaleManId: _SaleManId,
                Name: $("#Name").val(),
                Phone: $("#Phone").val(),
                Address: $("#Address").val(),
                Password: $("#Password").val(),
                IsActive: IsActive,
                AllowMultiOrders: allowMulti,
                MaxConcurrentOrders: maxConcurrent
            };

            if (object.Name === "" || object.Name.trim() === "") {
                md.showNotification("رجاءا ادخل الاسم");
                return;
            }
            if (object.Phone === "" || object.Phone.trim() === "") {
                md.showNotification("رجاءا ادخل رقم الهاتف");
                return;
            }
            if (_SaleManId === 0 && (object.Password === "" || object.Password.trim() === "")) {
                md.showNotification("رجاءا ادخل كلمة المرور");
                return;
            }

            call_ajax("POST", "SaleMan/Post", object, function (saved) {
                var sid = _SaleManId || (saved && (saved.saleManId || saved.SaleManId));
                function saveRestaurantsThenZones() {
                    if (typeof RestaurantPicker !== 'undefined') {
                        RestaurantPicker.saveSaleMan(sid, 'saleManRestaurantPicker', function () {
                            if (typeof ZonePicker !== 'undefined') {
                                ZonePicker.saveSaleMan(sid, 'saleManZonePicker', aftersaveSaleMan);
                            } else {
                                aftersaveSaleMan();
                            }
                        });
                    } else if (typeof ZonePicker !== 'undefined') {
                        ZonePicker.saveSaleMan(sid, 'saleManZonePicker', aftersaveSaleMan);
                    } else {
                        aftersaveSaleMan();
                    }
                }
                saveRestaurantsThenZones();
            });
        });
    </script>
</div>
