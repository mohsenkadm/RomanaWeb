
@{
    ViewData["Title"] = "الزبائن";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="content">
    <div class="content dark-edition">
        <div class="container-fluid">

            <!-- Page Summary -->
            <div class="rm-page-summary">
                <div class="rm-summary-icon bg-orange"><i class="material-icons">people</i></div>
                <div class="rm-summary-body">
                    <h4>ادارة الزبائن</h4>
                    <p>عرض وادارة الزبائن المسجلين. البحث بالاسم أو رقم الهاتف، مع تصفح الصفحات لسرعة التحميل.</p>
                </div>
                <div class="rm-summary-stats">
                    <div class="rm-stat"><span class="rm-stat-value" id="userSummaryTotal">-</span><span class="rm-stat-label">اجمالي</span></div>
                    <div class="rm-stat"><span class="rm-stat-value" id="userSummaryActive">-</span><span class="rm-stat-label">نشط</span></div>
                </div>
            </div>

            <!-- Filter Bar -->
            <div class="rm-filter-bar">
                <div class="row align-items-end">
                    <div class="col-lg-2 col-md-3 col-sm-6">
                        <label class="mb-2"> </label>
                        <button type="button" class="btn btn-success btnwidth" style="width:100%;" data-toggle="modal" data-target="#UsersModal" onclick="_UserId=0;">اضافة جديد <i class='material-icons'>add</i></button>
                    </div>
                    <div class="col-lg-4 col-md-5 col-sm-12">
                        <label class="mb-2">بحث (الاسم أو الهاتف)</label>
                        <input type="text" class="form-control alignright" placeholder="اكتب الاسم أو رقم الهاتف" autocomplete="off" name="Namese" id="Namese">
                    </div>
                    <div class="col-lg-2 col-md-2 col-sm-6">
                        <label class="mb-2">عدد الصف</label>
                        <select class="form-control" id="usersPageSize">
                            <option value="25" selected>25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-2 col-sm-6">
                        <label class="mb-2"> </label>
                        <button type="button" id="search-btn" class="btn btn-info btnwidth" style="width:100%;">بحث <i class='material-icons'>search</i></button>
                    </div>
                    <div class="col-lg-2 col-md-2 col-sm-6">
                        <label class="mb-2"> </label>
                        <button type="button" id="excel-btn" class="btn btn-success btnwidth" style="width:100%;">اكسل <i class='material-icons'>file_download</i></button>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-12 text-left">
                        <span class="rm-total-badge"><i class="material-icons">people</i> <span id="userTotalCount">0</span> زبون</span>
                        <span class="text-muted mr-3" style="margin-right:12px;">صفحة <span id="usersPageInfo">1 / 1</span></span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header card-header-primary" style="text-align:right">
                            <h4 class="card-title ">الزبائن</h4>
                            <p class="card-category">جدول لعرض الزبائن داخل التطبيق</p>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive" style="text-align: right;">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th scope="col">اقرب نقطة دالة</th>
                                            <th scope="col">نشط</th>
                                            <th scope="col">تاكيد</th>
                                            <th scope="col">العنوان</th>
                                            <th scope="col">رقم الهاتف</th>
                                            <th scope="col">اسم الزبون</th>
                                            <th scope="col"></th>
                                        </tr>
                                    </thead>
                                    <tbody id="tableUsers">
                                    </tbody>
                                </table>
                            </div>
                            <nav aria-label="تصفح الزبائن" class="mt-3">
                                <ul class="pagination justify-content-center flex-wrap" id="usersPagination"></ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="UsersModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content dark-edition">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">اضافة / تعديل زبون</h5>
                <button type="button" id="close1" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="row col-md-6 alignright">
                        <label class="text-primary">الاسم</label>
                        <input type="text" placeholder="اكتب الاسم" class="form-control alignright" autocomplete="off" name="Name" id="Name" />
                    </div>
                    <div class="row col-md-6 alignright">
                        <label class="text-primary">رقم الهاتف</label>
                        <input type="text" placeholder="اكتب رقم الهاتف" class="form-control alignright" autocomplete="off" name="Phone" id="Phone" />
                    </div>
                    <div class="row col-md-6 alignright">
                        <label class="text-primary">العنوان </label>
                        <input type="text" placeholder="اكتب  العنوان" class="form-control alignright" autocomplete="off" name="Address" id="Address" />
                    </div>
                    <div class="row col-md-6 alignright">
                        <label class="text-primary">اسم المستخدم</label>
                        <input type="text" placeholder="اكتب  اسم المستخدم" class="form-control alignright" autocomplete="off" name="UserName" id="UserName" />
                    </div>
                    <div class="row col-md-6 alignright">
                        <label class="text-primary">كلمة المرور</label>
                        <input type="text" placeholder="اتركها فارغة عند التعديل إن لم تتغير" class="form-control alignright" autocomplete="off" name="Password" id="Password" />
                    </div>

                    <div class="form-group col-md-6  alignright">
                        <label class="text-primary">نشط</label>
                        <div class='form-check col-md-6  alignright'>
                            <label class='form-check-label'>
                                <input class='form-check-input' type='checkbox' id='IsActive'>
                                <span class='form-check-sign'>
                                    <span class='check'></span>
                                </span>
                            </label>
                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="close" data-dismiss="modal">اغلاق</button>
                <button type="button" class="btn btn-success" id="save">حفظ</button>
            </div>
        </div>
    </div>
</div>
<div id="mydiv">
    <script>
        $("#close").on("click", function (e) {
            e.preventDefault();
        });
        $("#close1").on("click", function (e) {
            e.preventDefault();
        });
        $("#search-btn").on("click", function (e) {
            e.preventDefault();
            RefreshUsers();
        });
        $("#Namese").on("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                RefreshUsers();
            }
        });
        $("#usersPageSize").on("change", function () {
            RefreshUsers();
        });
        $("#excel-btn").on("click", function (e) {
            e.preventDefault();
            downloadUsersExcel();
        });
        $(document).ready(function () {
            loadUsersPage(1);
        });
        $("#save").on("click", function (e) {
            e.preventDefault();
            var IsActive = $('#IsActive').is(":checked");
            var object = {
                UserId: _UserId,
                Name: $("#Name").val(),
                Phone: $("#Phone").val(),
                Address: $("#Address").val(),
                UserName: $("#UserName").val(),
                Password: $("#Password").val(),
                IsActive: IsActive,
            };

            if (!object.Name || !object.Name.trim()) {
                md.showNotification("رجاءا ادخل الاسم ");
                return;
            }
            if (!object.Phone || !object.Phone.trim()) {
                md.showNotification("رجاءا ادخل رقم الهاتف ");
                return;
            }
            if (!object.Address || !object.Address.trim()) {
                md.showNotification("رجاءا ادخل العنوان ");
                return;
            }
            if (_UserId === 0 && (!object.Password || !object.Password.trim())) {
                md.showNotification("رجاءا ادخل كلمة المرور ");
                return;
            }

            call_ajax("POST", "Users/PostAdmin", object, aftersaveUsers);
        });
    </script>
</div>
